---
import '../styles/fonts.css';
import '../styles/global.css';
// The text face, preloaded: the stylesheet is inlined into the page, so
// without this hint the browser would only find the font once it has run
// style resolution and laid out the first text. The hero name is the largest
// paint, so EB Garamond starts while the HTML is still being parsed.
import garamond from '../assets/fonts/eb-garamond-latin-500-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** The 404 page: no canonical URL, and keep it out of search indexes. */
  notFound?: boolean;
}

const { title, description, notFound = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {notFound ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="preload" href={garamond} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#eceef4" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // The theme before the first paint, so a saved or system dark never
      // flashes paper. The toggle script owns changes after load.
      (function () {
        var v = null;
        try { v = localStorage.getItem('kk-theme'); } catch (e) {}
        var dark = v ? v === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        if (dark) {
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.content = '#0a0d19';
        }
      })();
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!notFound && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <!-- Structured data and any other page-specific head tags. -->
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
