---
/** "Email is fastest" at poster size in red, then the four links. */
interface Props {
  email: string;
  github: string;
  linkedin: string;
  resume: string;
}
const { email, github, linkedin, resume } = Astro.props;
---

<section class="sec say" id="contact" aria-labelledby="h-say">
  <div class="wrap">
    <p class="lab mono">Say hey</p>
    <h2 class="d" id="h-say">Email is fastest</h2>
    <ul>
      <li><a href={`mailto:${email}`}>{email}</a></li>
      <li><a href={github}>GitHub</a></li>
      <li><a href={linkedin}>LinkedIn</a></li>
      <li><a href={resume}>Resume, PDF</a></li>
    </ul>
  </div>
</section>

<style>
  h2 {
    font-size: clamp(4rem, 16vw, 16rem);
    color: var(--red);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin-top: 1.5rem;
    font-weight: 700;
    font-size: 1.3rem;
  }
  a {
    text-decoration: underline;
    text-decoration-thickness: 4px;
    text-decoration-color: var(--yellow);
    text-underline-offset: 0.2em;
    padding-block: 0.3rem;
  }
  a:hover {
    text-decoration-color: var(--blue);
  }
</style>
