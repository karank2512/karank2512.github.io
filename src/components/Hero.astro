---
import Controls from './Controls.astro';
import Session from './Session.astro';

interface Props {
  name: string;
  tagline: string;
  intro: string[];
  email: string;
  music: {
    playlistId: string;
    playlistTitle: string;
    openingTrack: string;
    openingArtist: string;
  };
}
const { name, tagline, intro, email, music } = Astro.props;
const [first, ...rest] = name.split(' ');
const last = rest.join(' ');

/** Link the first mention of thaw and RelayIQ without changing the approved words. */
function linkify(text: string): string {
  return text
    .replace(/\bthaw\b/, '<a href="#thaw">thaw</a>')
    .replace(/\bRelayIQ\b/, '<a href="#projects">RelayIQ</a>');
}
---

<section class="hero" id="hero" aria-labelledby="h1">
  <div class="field" aria-hidden="true"></div>
  <div class="wrap grid">
    <div>
      <h1 id="h1"><span class="l">{first}</span><span class="l">{last}</span></h1>
      <p class="role">{tagline}</p>
      <ul class="intro">
        {intro.map((line) => <li set:html={linkify(line)} />)}
      </ul>
      <Controls email={email} {...music} />
    </div>
    <Session />
  </div>
</section>

<script>
  // Pause every looping animation in the hero (background field, carets,
  // sound bars) when the hero is off screen or the tab is hidden.
  const hero = document.getElementById('hero');
  if (hero) {
    let offscreen = false;
    const sync = () => hero.classList.toggle('paused', offscreen || document.hidden);
    new IntersectionObserver((entries) => {
      offscreen = !entries.some((e) => e.isIntersecting);
      sync();
    }).observe(hero);
    document.addEventListener('visibilitychange', sync);
  }
</script>
