---
import { Image } from 'astro:assets';
import Controls from './Controls.astro';
import LatticeSvg from './LatticeSvg.astro';
// The headshot. A 300 x 400 JPEG; the image pipeline resizes it to the
// displayed size at 1x and 2x and writes webp files with their own name.
import headshot from '../assets/pro-headshot.jpg';

interface Metric {
  label: string;
  value: string;
  unit?: string;
  setup: string;
  source: string;
}

interface Props {
  name: string;
  tagline: string;
  intro: string[];
  email: string;
  photo: { alt: string };
  music: {
    playlist: { label: string; url: string };
    tracks: Array<{ title: string; artist: string; url: string }>;
  };
  /** The median fork metric (A1 in thaw.json). */
  fork: Metric | undefined;
  /** The restore metrics (A2 and A3). */
  restores: Metric[];
}
const { name, tagline, intro, email, photo, music, fork, restores } = Astro.props;
const [given, ...rest] = name.split(' ');
const last = rest.join(' ');
const receipt = restores[0]?.source;
const first = music.tracks[0];
if (!first) throw new Error('profile music.tracks is empty');

/** Link the first mention of thaw and RelayIQ without changing the approved words. */
function linkify(text: string): string {
  return text
    .replace(/\bthaw\b/, '<a href="#thaw">thaw</a>')
    .replace(/\bRelayIQ\b/, '<a href="#projects">RelayIQ</a>');
}
---

<section class="hero" id="hero" aria-labelledby="h1">
  <div class="scene">
    <div class="field" aria-hidden="true"></div>

    <!-- The copy comes first in the markup so the name and the intro, the
         largest text on the page, are parsed and painted before the 16 KB
         of lattice drawing that follows; the stage is positioned absolutely
         behind the copy, so the order changes nothing on screen. -->
    <div class="wrap grid">
      <div class="copy">
        <!-- The name and the tagline with the headshot beside them, in the
             first screen on every width. The photo is uncropped at its own
             3:4 ratio and declares its size, so nothing shifts. -->
        <div class="id">
          <h1 id="h1"><span class="l">{given}</span><span class="l">{last}</span></h1>
          <p class="role">{tagline}</p>
          <Image
            class="pic"
            src={headshot}
            alt={photo.alt}
            width={150}
            height={200}
            densities={[1, 2]}
            format="webp"
            quality={82}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
        <ul class="intro">
          {intro.map((line) => <li set:html={linkify(line)} />)}
        </ul>
        <!-- Contact me and Press play share one row. The turntable control
             is for fine pointers on wide screens; the plain button takes
             over on touch and at 820px and below. Both are in the DOM and
             the page script keeps their state in step. -->
        <div class="acts">
          <a class="cta" href={`mailto:${email}`}>Contact me</a>
          <Controls id="snd" variant="desk" />
          <Controls id="snd-touch" variant="touch" />
        </div>
      </div>
      <div class="room" aria-hidden="true"></div>
    </div>

    <div class="stage" id="stage">
      <LatticeSvg />
      <canvas id="hero-gl" aria-hidden="true"></canvas>
    </div>

    <div class="hud">
      <div class="hud-tl mono">
        <span>One running session. Drag to orbit, scroll to fork.</span>
        <button class="fork-btn" id="fork-btn" type="button" aria-pressed="false">Fork it</button>
      </div>

      {fork && (
        <dl class="hud-tr mono">
          <dt>{fork.label}</dt>
          <dd class="v">{fork.value}{fork.unit && <small>{fork.unit}</small>}</dd>
          <dd>vs about 340 s cold boot</dd>
          <dd>{fork.setup}</dd>
          <dd><a href={fork.source}>Receipt</a></dd>
        </dl>
      )}

      {restores.length > 0 && (
        <dl class="hud-br mono">
          <dt>Weight restore</dt>
          {restores.map((r) => (
            <>
              <dd class="v">{r.value}{r.unit && <small>{r.unit}</small>}</dd>
              <dd>{r.setup}</dd>
            </>
          ))}
          {receipt && <dd><a href={receipt}>Receipt</a></dd>}
        </dl>
      )}
    </div>
  </div>

  <!-- The player strip. Closed, and out of the tab order, until play is
       pressed. Then: the now-playing line (title, artist, and a link to the
       track on SoundCloud, which is the credit SoundCloud asks for),
       Previous and Next, and the plain link to the Spotify playlist. The
       one widget iframe is created by the page script inside the first
       press and lives in #widget, present but hidden and inert; the four
       tracks are listed in #snd-tracks for the script, first track first. -->
  <div class="wrap">
    <div id="sleeve">
      <div>
        <div class="in" id="player">
          <p class="np mono" id="np" aria-live="polite">
            <span class="np-state">Loading</span>:
            <span class="np-title">{first.title}</span>,
            <span class="np-artist">{first.artist}</span>.
            <a class="np-link" href={first.url} rel="noopener">On SoundCloud</a>
          </p>
          <div class="skip-btns">
            <button class="skip-btn" id="snd-prev" type="button">Previous</button>
            <button class="skip-btn" id="snd-next" type="button">Next</button>
          </div>
          <p class="pl-link"><a href={music.playlist.url} rel="noopener">{music.playlist.label}</a></p>
          <div class="widget" id="widget" inert></div>
        </div>
      </div>
    </div>
    <script is:inline type="application/json" id="snd-tracks" set:html={JSON.stringify(music.tracks)}></script>
  </div>
</section>
