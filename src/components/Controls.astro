---
/**
 * The sound control. Sound is off by default. The Spotify iframe is not in
 * the DOM until a button is pressed, so no third-party request happens on
 * load; it opens in the #sleeve strip under the hero scene.
 *
 * Two variants share one state (the page script keeps them in step):
 * - "hud": the hairline button with its caption and the playlist hint, in
 *   the bottom-left HUD corner. Shown on wide screens with a fine pointer.
 * - "touch": a plain large play button that sits beside "Contact me" in the
 *   first screen. Shown on coarse pointers and on narrow screens, where the
 *   HUD stacks below the stage and would push the control off the first
 *   screen.
 */
interface Props {
  id: string;
  variant: 'hud' | 'touch';
  playlistId: string;
  playlistTitle: string;
  openingTrack: string;
  openingArtist: string;
}
const { id, variant, playlistId, playlistTitle, openingTrack, openingArtist } = Astro.props;
const embedSrc = `https://open.spotify.com/embed/playlist/${playlistId}?utm_source=generator`;
---

<button
  class:list={['snd', { 'snd-touch': variant === 'touch' }]}
  id={id}
  type="button"
  aria-pressed="false"
  aria-controls="sleeve"
  data-embed-src={embedSrc}
  data-embed-title={`Spotify playlist: ${playlistTitle}`}
>
  <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path class="play" d="M6 4l14 8-14 8z" fill="currentColor"></path>
    <rect class="stop" x="5" y="5" width="14" height="14" fill="currentColor"></rect>
  </svg>
  <span class="off">Press play</span>
  <span class="on">Stop</span>
  {variant === 'hud' && (
    <span class="k">
      <span class="off">Sound off</span>
      <span class="on">Playing</span>
      <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
    </span>
  )}
</button>
{variant === 'hud' && (
  <p class="hint mono">
    Opens <strong>{playlistTitle}</strong>, the playlist I practice to, starting with {openingTrack} by {openingArtist}.
    Nothing plays until you press.
  </p>
)}
