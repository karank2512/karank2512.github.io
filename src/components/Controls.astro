---
/**
 * The sound control. Sound is off by default. The Spotify iframe is not in
 * the DOM until a button is pressed, so no third-party request happens on
 * load; it opens in the #sleeve strip under the hero scene.
 *
 * Two variants share one state (the page script keeps them in step):
 * - "desk": the turntable. A small 3D stage (a vinyl disc with a tonearm
 *   that lowers and spins while sound is on, and a row of equalizer bars
 *   that move only while sound is on; decoration, not analysis) beside the
 *   label and the "Sound off" / "Playing" caption. Shown on wide screens
 *   with a fine pointer. The SVG is the drawing before the scene loads and
 *   wherever WebGL is missing; its disc spins by CSS while sound is on.
 * - "touch": a plain large button with a small disc icon that spins while
 *   sound is on. Shown on coarse pointers and at 820px and below.
 */
interface Props {
  id: string;
  variant: 'desk' | 'touch';
  playlistId: string;
  playlistTitle: string;
  openingTrack: string;
  openingArtist: string;
}
const { id, variant, playlistId, playlistTitle } = Astro.props;
const embedSrc = `https://open.spotify.com/embed/playlist/${playlistId}?utm_source=generator`;
---

<button
  class:list={['snd', variant === 'touch' ? 'snd-touch' : 'snd-desk']}
  id={id}
  type="button"
  aria-pressed="false"
  aria-controls="sleeve"
  data-embed-src={embedSrc}
  data-embed-title={`Spotify playlist: ${playlistTitle}`}
>
  {variant === 'desk' ? (
    <span class="stage tt" id="vinyl-stage" aria-hidden="true">
      <svg class="fb" viewBox="0 0 140 72" preserveAspectRatio="xMidYMid meet" focusable="false">
        <!-- plinth -->
        <rect class="pl" x="4" y="14" width="88" height="50"></rect>
        <!-- the disc: rim, grooves, label -->
        <g class="disc">
          <circle class="rim" cx="40" cy="39" r="24"></circle>
          <circle class="gr" cx="40" cy="39" r="19"></circle>
          <circle class="gr" cx="40" cy="39" r="14"></circle>
          <circle class="em" cx="40" cy="39" r="7"></circle>
          <circle class="rim" cx="40" cy="39" r="1.2"></circle>
        </g>
        <!-- tonearm, parked -->
        <rect class="rim" x="76" y="18" width="8" height="8"></rect>
        <path class="arm" d="M80 22 L66 60"></path>
        <rect class="em" x="63" y="58" width="6" height="4"></rect>
        <!-- equalizer bars, resting -->
        <g class="eq">
          <rect x="102" y="54" width="4" height="10"></rect>
          <rect x="109" y="54" width="4" height="10"></rect>
          <rect x="116" y="54" width="4" height="10"></rect>
          <rect x="123" y="54" width="4" height="10"></rect>
          <rect x="130" y="54" width="4" height="10"></rect>
        </g>
      </svg>
      <canvas id="vinyl-gl"></canvas>
    </span>
  ) : (
    <svg class="disc-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="10.5"></circle>
      <circle cx="12" cy="12" r="7"></circle>
      <circle class="em" cx="12" cy="12" r="3.2"></circle>
      <circle cx="12" cy="12" r="0.8"></circle>
    </svg>
  )}
  <span class="tx">
    <span class="off">Press play</span>
    <span class="on">Stop</span>
    {variant === 'desk' && (
      <span class="k">
        <span class="off">Sound off</span>
        <span class="on">Playing</span>
        <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </span>
    )}
  </span>
</button>
