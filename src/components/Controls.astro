---
/**
 * The sound control, which lives in the bottom-left HUD corner of the hero.
 * Sound is off by default. The Spotify iframe is not in the DOM until the
 * button is pressed, so no third-party request happens on load; it opens in
 * the #sleeve strip under the hero scene. On touch devices (pointer: coarse)
 * the CSS renders the same button as a plain large play button.
 */
interface Props {
  playlistId: string;
  playlistTitle: string;
  openingTrack: string;
  openingArtist: string;
}
const { playlistId, playlistTitle, openingTrack, openingArtist } = Astro.props;
const embedSrc = `https://open.spotify.com/embed/playlist/${playlistId}?utm_source=generator`;
---

<button
  class="snd"
  id="snd"
  type="button"
  aria-pressed="false"
  aria-controls="sleeve"
  data-embed-src={embedSrc}
  data-embed-title={`Spotify playlist: ${playlistTitle}`}
>
  <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path class="play" d="M6 4l14 8-14 8z" fill="currentColor"></path>
    <rect class="stop" x="5" y="5" width="14" height="14" fill="currentColor"></rect>
  </svg>
  <span class="off">Press play</span>
  <span class="on">Stop</span>
  <span class="k">
    <span class="off">Sound off</span>
    <span class="on">Playing</span>
    <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
  </span>
</button>
<p class="hint mono">
  Opens <strong>{playlistTitle}</strong>, the playlist I practice to, starting with {openingTrack} by {openingArtist}.
  Nothing plays until you press.
</p>

<script>
  const button = document.getElementById('snd') as HTMLButtonElement | null;
  const slot = document.getElementById('emb');
  if (button && slot) {
    let on = false;
    button.addEventListener('click', () => {
      on = !on;
      button.setAttribute('aria-pressed', String(on));
      document.body.classList.toggle('on', on);
      if (on) {
        const frame = document.createElement('iframe');
        frame.src = button.dataset.embedSrc ?? '';
        frame.title = button.dataset.embedTitle ?? 'Spotify playlist';
        frame.width = '100%';
        frame.height = '352';
        frame.loading = 'lazy';
        frame.allow = 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture';
        slot.replaceChildren(frame);
      } else {
        // Removing the iframe is the only reliable way to stop the audio.
        slot.replaceChildren();
      }
    });
  }
</script>
