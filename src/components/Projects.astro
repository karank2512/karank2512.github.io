---
/**
 * Four posters on equal footing in a two-by-two grid: the same size, the
 * same parts (date stamp, eyebrow, title, one bold line, bullets, footer
 * links), each in its own pigment. No project is featured. A poster is not
 * itself a link, so its footer can hold more than one; hover lifts the sheet
 * and drops a hard ink shadow.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;
const count = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six'][projects.length] ?? String(projects.length);
---

<section class="sec" id="projects" aria-labelledby="h-proj">
  <div class="wrap">
    <h2 class="lab mono" id="h-proj">{count} projects</h2>
    <ul class="posters">
      {projects.map((p) => (
        <li class:list={['poster', p.data.tone]} id={p.id}>
          <span class="when mono">{p.data.when}</span>
          <span class="eyebrow mono">{p.data.eyebrow}</span>
          <h3 class="d">{p.data.title}</h3>
          <p class="sub">{p.data.sub}</p>
          <ul class="bul">
            {p.data.bullets.map((b) => (
              <li>
                {b.text}
                {b.link && (
                  <>
                    {' '}
                    <a href={b.link.href}>{b.link.label}</a>.
                  </>
                )}
              </li>
            ))}
          </ul>
          <p class="foot">
            {p.data.links.length > 0 ? p.data.links.map((l) => <a href={l.href}>{l.label}</a>) : <span>{p.data.soon ?? 'Repo opens soon'}</span>}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .posters {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .poster {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: 0.8rem;
    position: relative;
    border: var(--rule) solid var(--ink);
    padding: 1.4rem;
    background: var(--c);
    color: var(--fg);
    transition:
      transform 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }
  .poster:hover {
    transform: translate(-5px, -5px);
    box-shadow: 8px 8px 0 var(--ink);
  }
  .red {
    --c: var(--red-fill);
    --fg: var(--paper);
  }
  .blue {
    --c: var(--blue);
    --fg: var(--paper);
  }
  .yellow {
    --c: var(--yellow);
    --fg: var(--ink);
  }
  .paper {
    --c: var(--paper);
    --fg: var(--ink);
  }
  .ink {
    --c: var(--ink);
    --fg: var(--paper);
  }
  /* Five posters: the odd one out spans the row so the grid has no hole. */
  .posters li:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }
  @media (max-width: 640px) {
    .posters li:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }
  .when {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    font-size: 0.72rem;
    border: 2px solid currentColor;
    padding: 0.15rem 0.45rem;
  }
  .eyebrow {
    padding-right: 11rem;
  }
  h3 {
    font-size: clamp(3rem, 6vw, 5.5rem);
  }
  .sub {
    font-weight: 700;
    font-size: 1.05rem;
    max-width: 58ch;
  }
  .bul {
    font-size: 0.98rem;
    max-width: 58ch;
    gap: 0.5rem;
  }
  .bul li::before {
    background: currentColor;
  }
  .bul a {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }
  .foot {
    margin-top: auto;
    padding-top: 0.6rem;
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
    font-weight: 700;
  }
  .foot a {
    text-decoration: none;
    border-bottom: 3px solid currentColor;
    padding-block: 0.2rem;
    overflow-wrap: anywhere;
  }
  .foot a:hover {
    border-bottom-color: transparent;
  }
  @media (min-width: 641px) and (max-width: 800px) {
    .when {
      position: static;
      align-self: flex-start;
    }
    .eyebrow {
      padding-right: 0;
    }
    .foot {
      font-size: 0.85rem;
    }
  }
  @media (max-width: 640px) {
    .posters {
      grid-template-columns: 1fr;
    }
    .when {
      position: static;
      align-self: flex-start;
    }
    .eyebrow {
      padding-right: 0;
    }
  }
</style>
