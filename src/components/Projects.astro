---
import type { CollectionEntry } from 'astro:content';
import Mark from './Mark.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;

/** What the card says under the tagline. The featured project points up. */
function blurb(p: CollectionEntry<'projects'>): string {
  if (p.data.kind === 'featured') {
    return `${p.data.credit ? `${p.data.credit}. ` : ''}The receipts and the engineering tour are above.`;
  }
  return p.data.summary;
}
---

<section class="sec proj" id="projects" aria-labelledby="h-proj">
  <div class="wrap">
    <div class="grid">
      <p class="lab mono">Projects</p>
      <div>
        <h2 id="h-proj" class="rv">Four projects<span class="dot">.</span></h2>
        <p class="lead rv">Cards with a link open the repo or the site. tell gets one when it is public.</p>
      </div>
    </div>

    <div class="deck" id="deck">
      <canvas id="deck-gl" aria-hidden="true"></canvas>
      <ul class="cards" id="cards">
        {projects.map((p, i) => {
          const primary = p.data.links[0];
          const Tag = primary ? 'a' : 'div';
          return (
            <li class:list={['slot', `s${i}`, { linked: Boolean(primary) }]}>
              <Tag class="card" href={primary?.href}>
                <Mark id={p.id} />
                <h3>{p.data.title}</h3>
                <span class="sp mono">{p.data.tagline}</span>
                <p>
                  {blurb(p)}
                  {p.data.note && <span class="note">{p.data.note}</span>}
                </p>
                {primary && (
                  <svg class="go" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M6 18L18 6M9 6h9v9"></path>
                  </svg>
                )}
              </Tag>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>
