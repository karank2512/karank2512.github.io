---
/**
 * Leadership roles, compact rows on the same rail as Experience. Rendered
 * only when src/content/leadership has at least one entry; index.astro
 * skips the section and its nav link otherwise.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'leadership'>[];
}
const { entries } = Astro.props;
---

<section class="sec lead" id="leadership" aria-labelledby="h-lead">
  <div class="wrap grid">
    <p class="lab mono">Leadership</p>
    <div>
      <h2 id="h-lead" class="rv">Leadership<span class="dot">.</span></h2>
      <ol class="roles">
        {entries.map((e) => (
          <li class="rv">
            <span class="mk" aria-hidden="true"></span>
            <span class="r">
              {e.data.role}
              <span class="o">{e.data.org}</span>
            </span>
            <span class="w mono">{e.data.start} to {e.data.end}</span>
            <span class="ln">{e.data.line}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
