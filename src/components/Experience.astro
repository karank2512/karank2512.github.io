---
/**
 * Experience. The first entry is thaw, featured: it carries the project's
 * tagline, summary, credit line and links, and holds the engineering tour
 * and the receipts list behind a disclosure (see Featured.astro). The other
 * roles follow as rows on the same rail. Every entry has its own graphic
 * (Tile.astro) beside its text. The rail holds the label and the degree
 * line; the headshot lives in the hero.
 */
import type { CollectionEntry } from 'astro:content';
import Featured from './Featured.astro';
import Tile from './Tile.astro';

interface Props {
  roles: CollectionEntry<'experience'>[];
  featured: CollectionEntry<'projects'>;
  education: string;
}
const { roles, featured, education } = Astro.props;
/** The entry id without its order prefix (01-thaw becomes thaw) picks the scene and the drawing. */
const key = (id: string): string => id.replace(/^\d+-/, '');
---

<section class="sec exp" id="experience" aria-labelledby="h-exp">
  <div class="wrap grid">
    <div class="lab">
      <p class="mono">Experience</p>
      <p class="edu">{education}</p>
    </div>
    <div>
      <h2 id="h-exp" class="rv">Background<span class="dot">.</span></h2>
      <ol class="roles">
        {roles.map((r) =>
          r.data.project ? (
            <Featured role={r} project={featured} />
          ) : (
            <li class="rv">
              <span class="mk" aria-hidden="true"></span>
              <Tile id={key(r.id)} />
              <span class="r">
                {r.data.role}
                <span class="o">{r.data.org}, {r.data.location}</span>
              </span>
              <span class="w mono">{r.data.start} to {r.data.end}</span>
              <span class="ln">{r.data.line}</span>
            </li>
          ),
        )}
      </ol>
    </div>
  </div>
</section>
