---
/**
 * "Where I've worked": every role, then the leadership roles, as rows on one
 * list cut by rules. Dates in mono on the left, the role in display type and
 * the org under it in the middle, the resume bullets on the right. The degree
 * line and coursework close the section in mono.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  roles: CollectionEntry<'experience'>[];
  leadership: CollectionEntry<'leadership'>[];
  education: string;
  coursework?: string;
}
const { roles, leadership, education, coursework } = Astro.props;
const rows = [
  ...roles.map((r) => ({ id: r.id, ...r.data, location: r.data.location as string | undefined })),
  ...leadership.map((l) => ({ id: l.id, ...l.data, location: undefined })),
];
---

<section class="sec" id="experience" aria-labelledby="h-exp">
  <div class="wrap">
    <p class="lab mono">Background</p>
    <h2 class="d" id="h-exp">Where I've worked</h2>
    <ol class="roles">
      {rows.map((r) => (
        <li>
          <span class="w mono">{r.start} to {r.end}</span>
          <span class="r">
            <span class="d">{r.role}</span>
            <span class="o">{r.org}{r.location && `. ${r.location}`}</span>
          </span>
          <ul class="bul">
            {r.bullets.map((b) => (
              <li>
                {b.text}
                {b.link && (
                  <>
                    {' '}
                    <a href={b.link.href}>{b.link.label}</a>.
                  </>
                )}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
    <p class="edu mono">{education} {coursework}</p>
  </div>
</section>

<style>
  h2 {
    margin-bottom: 1.5rem;
  }
  .roles {
    border-top: var(--rule) solid var(--ink);
  }
  .roles > li {
    display: grid;
    grid-template-columns: 7rem 1fr 1.4fr;
    gap: 1rem 1.5rem;
    padding-block: 1.1rem;
    border-bottom: 3px solid var(--ink);
  }
  .w {
    padding-top: 0.3rem;
  }
  .r .d {
    display: block;
    font-size: 1.6rem;
    line-height: 1;
  }
  .o {
    display: block;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--mute);
    margin-top: 0.3rem;
  }
  .bul {
    max-width: 62ch;
    gap: 0.4rem;
  }
  .bul li::before {
    background: var(--red);
    width: 0.5rem;
    height: 0.5rem;
    top: 0.55em;
  }
  .edu {
    margin-top: 1.2rem;
    text-transform: none;
    letter-spacing: 0;
    color: var(--mute);
  }
  @media (max-width: 900px) {
    .roles > li {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
  }
</style>
