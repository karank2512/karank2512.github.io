    /* One divider per section (v17): the label's own rules cut the page,
       so the labeled sections carry no full-width border of their own. The
       footer has no label and keeps its rule. */
    .about { padding-top: 8vh; padding-bottom: 12vh; }
    .about-t { max-width: 58ch; font-size: clamp(18px, 1.6vw, 22px); line-height: 1.45; display: grid; gap: 1.2em; }
    .about-links { margin-top: 48px; display: flex; justify-content: center; gap: 26px; flex-wrap: wrap; }
