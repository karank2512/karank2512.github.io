    .row-l { max-width: 56ch; font-size: 16px; line-height: 1.45; }
    .row-links { display: flex; gap: 22px; justify-content: center; }

    .exp { padding-top: 10vh; padding-bottom: 4vh; display: grid; gap: 26px; justify-items: center; }
    .exp-line, .exp-edu { max-width: 62ch; font-size: 18px; line-height: 1.45; }
    .exp-edu { color: var(--mute); font: 600 13px/1.6 var(--mono); text-transform: uppercase; letter-spacing: .02em; margin-top: 18px; }

    .foot { padding-top: 18vh; padding-bottom: 64px; border-top: 4px solid var(--ink); display: grid; justify-items: center; gap: 44px; }
    .foot-mail a {
      font: 400 clamp(2.4rem, 6.5vw, 7rem)/0.95 var(--display); text-transform: uppercase;
      color: var(--red); text-decoration: none; letter-spacing: -0.005em;
    }
