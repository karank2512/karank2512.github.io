type Project = { id: string; name: string; desc: string; shot: string; shotAlt: string; side: number; links: { text: string; href: string }[] };

const FULL_PAN = 0.212; // the whole travel, as a fraction of the shot's height (about 27% of a 2:1 frame)
function fitShot(w: number, h: number, frame: number, side: number): { width: string; travel: string } {
  const a = w / h;
  const full = (a / frame) / (1 - FULL_PAN); // the width that gives the full pan
  const width = Math.max(1, a / frame, Math.min(1 + 2 * side, full));
  const hr = (width * frame) / a; // shot height over frame height, at least 1
  const travel = Math.min(FULL_PAN, (hr - 1) / hr);
  return { width: `${(width * 100).toFixed(2)}%`, travel: `${(-travel * 100).toFixed(2)}%` };
}
const FRAME_DESKTOP = 2; // 2:1, every width above 767px
const FRAME_MOBILE = 16 / 9; // 16:9 at phone widths
const shotVars = (p: Project): string => {
  const m = workShot(p.shot);
  const d = fitShot(m.width, m.height, FRAME_DESKTOP, p.side);
  const mo = fitShot(m.width, m.height, FRAME_MOBILE, p.side);
  return `--wd: ${d.width}; --td: ${d.travel}; --wm: ${mo.width}; --tm: ${mo.travel}`;
};

