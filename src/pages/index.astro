    .proj { display: grid; grid-template-columns: 7fr 5fr; column-gap: clamp(28px, 4vw, 56px); row-gap: 34px; align-items: center; text-align: left; }
    .proj:nth-child(even) { grid-template-columns: 5fr 7fr; }
    .proj-media { grid-column: 1; grid-row: 1; }
