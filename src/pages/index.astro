---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Featured from '../components/Featured.astro';
import Projects from '../components/Projects.astro';
import Experience from '../components/Experience.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const profile = await getEntry('profile', 'main');
if (!profile) throw new Error('src/content/profile/main.json is missing');

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.find((p) => p.data.kind === 'featured');
if (!featured) throw new Error('No featured project. Set "kind": "featured" on one project.');

// The hero HUD shows only receipted numbers, read from the featured project.
const metric = (no: string) => featured.data.metrics.find((m) => m.no === no);
const fork = metric('A1');
const restores = [metric('A2'), metric('A3')].filter((m): m is NonNullable<typeof m> => Boolean(m));

const roles = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);

const { name, tagline, intro, education, contact, music, photo } = profile.data;
const title = `${name}. Engineer, co-founder of thaw.`;
const description =
  'Karan Kapur co-founded thaw, open-source LLM inference infrastructure in Rust and CUDA, and owns its cloud storage layer. Looking for founding engineer, forward deployed or GTM engineering roles at AI startups.';
---

<Base title={title} description={description}>
  <Header name={name} />
  <main id="main">
    <Hero name={name} tagline={tagline} intro={intro} email={contact.email} music={music} fork={fork} restores={restores} />
    <Featured project={featured} />
    <Projects projects={projects} />
    <Experience roles={roles} education={education} photo={photo} />
    <Contact {...contact} />
  </main>
  <Footer />
  <!-- The one page script: sound and fork controls, offscreen pause, the
       tour scroll, and the lazy scene imports. Bundled to a single small
       module; three.js stays in the scene chunks it pulls in later. -->
  <script>
    import '../scripts/page';
  </script>
</Base>
