---
<Base title={title} description={description}>
  <Fragment slot="head">
    <meta name="author" content={name} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <main id="main" class="v17">
    <canvas id="air" aria-hidden="true"></canvas>
    <header class="chrome" aria-label="Site">
      <a class="chrome-name" href="#top">Karan Kapur</a>
      <nav class="chrome-nav" aria-label="Quick links">
        <a href="/essays">Essays</a>
        <a href="https://github.com/karank2512">GitHub</a>
        <a href="https://www.linkedin.com/in/karankapur5">LinkedIn</a>
        <a href="/resume.pdf">Resume</a>
      </nav>
      {/* The player's transport. One audio element on the page (#player-audio,
          in Off the clock); these buttons and the track list there drive it.
          Disabled in the HTML, enabled by the script. */}
      <div class="bar" id="bar" data-state="idle" role="group" aria-label="Player">
        <button type="button" class="bbtn" id="bar-prev" aria-label="Previous track" disabled><span aria-hidden="true">&larr;</span></button>
        <button type="button" class="bbtn bbtn-play" id="bar-play" aria-pressed="false" disabled>Play</button>
        <button type="button" class="bbtn" id="bar-next" aria-label="Next track" disabled><span aria-hidden="true">&rarr;</span></button>
        <span class="bar-now" id="bar-status">No track loaded</span>
      </div>
      <p class="stamp"><span class="stamp-dot" aria-hidden="true"></span>Open to work</p>
      <button type="button" class="theme-toggle" id="theme-toggle" aria-pressed="false" aria-label="Switch to dark theme">
        <svg class="icon-sun" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M18.7 5.3l-1.8 1.8M7.1 16.9l-1.8 1.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
      </button>
    </header>

    <section class="first" id="top" aria-label="Introduction">
      <h1 class="first-name" id="hero-name" data-ink data-hero>Karan Kapur</h1>
      <div class="first-r">
        <p class="first-line" id="hero-line" data-ink data-hero>I build software with AI agents and the tooling around them.</p>
        <p class="first-p" id="hero-p" data-ink data-hero>Right now that&rsquo;s mostly tools for GTM teams: deciding whether a lead is worth enriching, turning job boards and filings into buying signals, and comparing data vendors to see which ones actually get company data right. I learn most of it by building. I started coding because of the IPL. Off the clock I&rsquo;m DJing, watching the NBA, soccer and supporting RedBull in Formula 1.</p>
      </div>
      <a class="to-work" href="#work"><span>See all work</span><span aria-hidden="true">&darr;</span></a>
    </section>

    <section class="about" id="about" aria-labelledby="h-about">
      <h2 class="label" id="h-about"><span class="label-rule" aria-hidden="true"></span><span class="label-t" data-ink>About</span><span class="label-rule" aria-hidden="true"></span></h2>
      <div class="about-t">
        <p id="about-1" data-ink>I studied Computer Science and Data Science at UW&ndash;Madison. Right now I&rsquo;m a Data Analyst at the Wisconsin Union, where I shipped the app that now runs staff scheduling. Before that I spent my senior capstone at Eurofins, turning messy lab records into forecasts the technicians still use, and a summer at OpenAI x UW&ndash;Madison SAIL building a GPT-4 retrieval assistant.</p>
      </div>
      <div class="photos" id="photos">
        {photos.map((ph) => (
          <figure data-vis style={`--fp: ${ph.focus}`}>
            <div class="vis"><Image src={pick(ph.file)} alt={ph.alt} width={480} densities={[1, 1.5]} format="webp" quality={78} loading="lazy" decoding="async" /></div>
            <figcaption>{ph.cap}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="work" id="work" aria-labelledby="work-h">
      <h2 class="label" id="work-h"><span class="label-rule" aria-hidden="true"></span><span class="label-t" data-ink>Selected work</span><span class="label-rule" aria-hidden="true"></span></h2>
      <div class="projs">
        {selected.map((p) => (
          <article class="proj" id={`proj-${p.id}`}>
            <figure class="proj-media" data-vis data-side={p.side} style={shotVars(p)}>
              <div class="vis"><Image src={workShot(p.shot)} alt={p.shotAlt} width={800} densities={[1, 1.5]} format="webp" quality={80} loading="lazy" decoding="async" /></div>
            </figure>
            <div class="proj-cap">
              <p class="proj-name" data-ink>{p.name}</p>
              <p class="proj-d" data-ink>{p.desc}</p>
              <p class="proj-l">
                {p.links.map((l) => <a href={l.href}>{l.text}</a>)}
              </p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="more" id="all-work" aria-labelledby="more-h">
      <h2 class="label" id="more-h"><span class="label-rule" aria-hidden="true"></span><span class="label-t" data-ink>All work</span><span class="label-rule" aria-hidden="true"></span></h2>
      <nav class="cats" id="all-work-cats" aria-label="All work categories">
        {catalog.map((g) => <a href={`#grp-${g.id}`}>{g.title}</a>)}
      </nav>
      {catalog.map((g) => (
        <div class="grp" id={`grp-${g.id}`}>
          <h3 class="grp-t" data-ink>{g.title}</h3>
          {g.rows.map((r) => (
            <div class="row" id={r.id}>
              <p class="row-h" data-ink><span class="row-n">{r.name}</span> <span class="row-m">{r.meta}</span></p>
              <p class="row-l" data-ink>{r.line}</p>
              {r.links.length > 0 && (
                <p class="row-links">
                  {r.links.map((l) => <a href={l.href}>{l.text}</a>)}
                </p>
              )}
            </div>
          ))}
        </div>
      ))}
    </section>

    <section class="life" id="life" aria-labelledby="h-life">
      <h2 class="label" id="h-life"><span class="label-rule" aria-hidden="true"></span><span class="label-t" data-ink>Off the clock</span><span class="label-rule" aria-hidden="true"></span></h2>
      <p class="life-line" id="life-line" data-ink>Before Madison I played table tennis at the national level in India.</p>
      {/* Listening lately: the song tiles, status and seek bar. Native
          audio, preload none, no src until a play gesture. Play, pause,
          previous and next sit in the top bar (#bar); the same script
          drives both. Controls start disabled in the HTML; the script
          enables them. */}
      <div class="player" id="player" data-player data-base="/audio/" data-state="idle">
        <p class="player-k" id="player-k">Listening lately</p>
        <p class="player-now" id="player-status" aria-live="polite">No track loaded</p>
        <p class="player-hint">Tap a song to play it. Pause and skip from the top bar.</p>
        <div class="player-seek">
          <span class="ptime" id="player-cur">0:00</span>
          <input type="range" id="player-range" min="0" max="1000" value="0" step="1" aria-label="Seek" aria-valuetext="No track loaded" disabled />
          <span class="ptime" id="player-dur">--:--</span>
        </div>
        {/* Song tiles: one tile per local file, each a real button. A
            click loads that song and plays it, whatever the player was
            doing. The pressed tile is the one selected or playing. */}
        <ul class="tiles" id="player-tracks" aria-label="Listening lately" data-default={defaultTrack}>
          {tracks.map((t, i) => (
            <li>
              <button type="button" class="track tile" data-track={t.id} data-i={i} aria-pressed="false" disabled>
                <span class="tile-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="tile-a">{t.artist}</span>
                <span class="tile-t">{t.title}</span>
                <span class="tile-go" aria-hidden="true">Play</span>
              </button>
            </li>
          ))}
        </ul>
        <audio id="player-audio" preload="none"></audio>
        {/* The playlist: one link out, nothing embedded, no third-party request from this page. */}
        <p class="music"><a class="music-a" href={playlist.url} target="_blank" rel="noopener">{playlist.label}</a></p>
      </div>
    </section>

    <section class="exp" id="experience" aria-labelledby="exp-h">
      <h2 class="label" id="exp-h"><span class="label-rule" aria-hidden="true"></span><span class="label-t" data-ink>Experience</span><span class="label-rule" aria-hidden="true"></span></h2>
      {experience.map((line, i) => <p class="exp-line" id={`exp-${i}`} data-ink>{line}</p>)}
    </section>

    <section class="book" id="book" aria-label="Book a time">
      <p class="book-line" data-ink><a class="book-a" href="https://cal.boardy.ai/karankapur5" target="_blank" rel="noopener">If you're cool, book a time <span class="book-arrow" aria-hidden="true">&rarr;</span></a></p>
