    .life { padding-top: 10vh; padding-bottom: 12vh; }
    .life-line { max-width: 56ch; font-size: clamp(18px, 1.6vw, 22px); line-height: 1.45; }
    .photos {
      margin-top: 72px; max-width: var(--col);
