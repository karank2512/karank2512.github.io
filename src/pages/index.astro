      .proj-media, .proj:nth-child(even) .proj-media { grid-column: 1; grid-row: 1; width: min(100%, 960px); }
      .proj-cap, .proj:nth-child(even) .proj-cap { grid-column: 1; grid-row: 2; justify-items: center; max-width: 60ch; }
