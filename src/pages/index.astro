---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import Life from '../components/Life.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Signature from '../components/effects/Signature.astro';

const profile = await getEntry('profile', 'main');
if (!profile) throw new Error('src/content/profile/main.json is missing');

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const roles = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const leadership = (await getCollection('leadership')).sort((a, b) => a.data.order - b.data.order);
if (projects.length === 0) throw new Error('No projects in src/content/projects.');
if (roles.length === 0) throw new Error('No roles in src/content/experience.');

const { name, tagline, intro, targets, education, coursework, contact, music, photo, skills, life } = profile.data;
const title = `${name}. Engineer, co-founder of thaw.`;
const description =
  'Karan Kapur co-founded thaw, open-source LLM inference infrastructure in Rust and CUDA, and owns its cloud storage layer. Looking for founding engineer, forward deployed or GTM engineering roles at AI startups.';

// Structured data: the page is a profile page whose main entity is Karan,
// so a search engine can tie the name to the role, the employer, the school
// and the GitHub and LinkedIn profiles. Facts come from the profile and
// experience content only; no number appears here. The job title pairs with
// worksFor below, so it is the thaw role; the role list runs newest first and
// does not start with thaw.
const current = roles.find((r) => r.data.org === 'thaw')?.data;
if (!current) throw new Error('No thaw role in src/content/experience; the structured data names it.');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  dateModified: new Date().toISOString().slice(0, 10),
  mainEntity: {
    '@type': 'Person',
    '@id': `${Astro.site}#karan-kapur`,
    name,
    url: String(Astro.site),
    image: new URL('/og-image.png', Astro.site).href,
    description,
    email: `mailto:${contact.email}`,
    jobTitle: `${current.role}, ${current.org}`,
    worksFor: {
      '@type': 'Organization',
      name: 'thaw',
      url: 'https://thaw.sh',
      sameAs: ['https://github.com/thaw-ai/thaw'],
    },
    alumniOf: {
      '@type': 'CollegeOrUniversity',
      name: 'University of Wisconsin-Madison',
      sameAs: 'https://www.wisc.edu/',
    },
    homeLocation: { '@type': 'Place', name: 'Madison, WI' },
    knowsAbout: ['LLM inference infrastructure', 'Rust', 'CUDA', 'cloud storage', 'GTM engineering', 'forward deployed engineering'],
    sameAs: [contact.github, contact.linkedin],
  },
};

const sections = [
  { href: '#projects', label: 'Projects' },
  { href: '#experience', label: 'Experience' },
  { href: '#skills', label: 'Skills' },
  { href: '#life', label: 'Off the clock' },
  { href: '#contact', label: 'Contact' },
];
---

<Base title={title} description={description}>
  <Fragment slot="head">
    <meta name="author" content={name} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <Header name={name} sections={sections} />
  <main id="main">
    <Hero name={name} tagline={tagline} intro={intro} targets={targets} photo={photo} contact={contact} />
    <Signature />
    <Projects projects={projects} />
    <Experience roles={roles} leadership={leadership} education={education} coursework={coursework} />
    <Skills skills={skills} />
    <Life photos={life.photos} line={life.line} playlist={music.playlist} />
    <Contact {...contact} />
  </main>
  <Footer />
</Base>
