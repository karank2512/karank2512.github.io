    .chrome-nav a:hover::after { width: 100%; }
    .stamp {
      display: flex; align-items: center; gap: 8px;
      font: 600 12px/1 var(--mono); text-transform: uppercase; letter-spacing: .02em;
      border: 3px solid var(--ink); padding: 8px 10px; margin: 0;
    }
    .stamp-dot { width: 9px; height: 9px; background: var(--red); animation: v16blink 1.6s steps(1) infinite; }
    @keyframes v16blink { 50% { opacity: 0; } }
    /* The transport in the bar: three small buttons and a one-line state,
       in the bar's own mono. State lives on data-state, mirrored from the
       player box. */
    .bar { display: flex; align-items: center; gap: 8px; }
    .bbtn {
      font: 600 11px/1 var(--mono); text-transform: uppercase; letter-spacing: .02em;
      color: var(--ink); background: var(--paper); border: 3px solid var(--ink); cursor: pointer;
      min-width: 34px; height: 34px; padding: 0 8px;
    }
    .bbtn-play { min-width: 62px; }
    .bbtn[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
    .bbtn:hover:not(:disabled) { background: var(--yellow); color: var(--ink); }
    .bbtn:disabled { cursor: not-allowed; color: var(--mute); border-color: var(--mute); }
    .bar-now {
      font: 600 11px/1.2 var(--mono); text-transform: uppercase; letter-spacing: .02em; color: var(--mute);
      max-width: 26ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .bar[data-state="playing"] .bar-now, .bar[data-state="loading"] .bar-now { color: var(--ink); }
    .bar[data-state="error"] .bar-now { color: var(--red); }

    /* Every section is a centered column with centered text; hierarchy
       comes from size and the rules. */
    .v16 section, .v16 .foot { padding-left: var(--pad); padding-right: var(--pad); text-align: center; }
    .v16 section > *, .v16 .foot > * { margin-left: auto; margin-right: auto; }

    /* Hero: the name on the left, two lines; the tagline on the right,
