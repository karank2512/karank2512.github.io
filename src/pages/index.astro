  <script is:inline>
    // The light/dark turn. The bootstrap in the head sets the first theme;
    // this owns the toggle, persists the choice, follows the system while
    // no choice is stored, and tells the mist to re-shade (themechange).
    (function () {
      var d = document.documentElement, btn = document.getElementById('theme-toggle');
      var meta = document.querySelector('meta[name="theme-color"]');
      function apply(theme, save) {
        d.dataset.theme = theme;
        if (meta) meta.content = theme === 'dark' ? '#0a0d19' : '#eceef4';
        if (btn) {
          btn.setAttribute('aria-pressed', String(theme === 'dark'));
          btn.setAttribute('aria-label', theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
        }
        if (save) { try { localStorage.setItem('kk-theme', theme); } catch (e) {} }
        d.dispatchEvent(new Event('themechange'));
      }
      if (btn) btn.addEventListener('click', function () { apply(d.dataset.theme === 'dark' ? 'light' : 'dark', true); });
      apply(d.dataset.theme === 'dark' ? 'dark' : 'light', false);
    })();
