          node.parentNode.replaceChild(frag, node);
        } else if (node.nodeType === 1) {
          Array.prototype.slice.call(node.childNodes).forEach(splitNode);
        }
      }
      var inkEls = Array.prototype.slice.call(document.querySelectorAll('[data-ink]'));
      inkEls.forEach(function (el) {
        var hero = el.hasAttribute('data-hero');
        var len = el.textContent.replace(/\s+/g, '').length;
        idx = 0;
        Array.prototype.slice.call(el.childNodes).forEach(splitNode);
        var n = idx;
        // Hero: 500 ms spread, small jitter. Everything else: 0.4 s plus
        // 1 s per 400 characters, capped at 1.2 s, jitter a tenth of that.
        var spread = hero ? 500 : Math.min(1200, 400 + len * 2.5);
        var amp = hero ? 30 : spread / 10;
        var letters = el.querySelectorAll('.il');
        for (var i = 0; i < letters.length; i++) {
          var f = n > 1 ? i / (n - 1) : 0;
          letters[i].style.setProperty('--d', Math.max(0, Math.round(f * spread + jitter(i, amp))) + 'ms');
          letters[i].style.setProperty('--ds', Math.max(0, Math.round(f * 250 + jitter(i, 25))) + 'ms');
        }
      });
      function ink(el) { el.classList.remove('off', 'set'); el.classList.add('on'); }
      function settle(el) { el.classList.remove('off', 'on'); el.classList.add('set'); }
      function smear(el) { el.classList.remove('on', 'set'); el.classList.add('off'); }
      function shown(el) { return el.classList.contains('on') || el.classList.contains('set'); }

      // Scroll velocity over the last 150 to 250 ms, in pixels per second.
      // Over about two screens a second the page is being flicked and
      // whatever is on screen settles at once. A small wheel step after a
      // pause reads as slow (the window never shrinks under 150 ms); a jump
      // of a screen or more reads as fast however long the pause before it
      // (the window never grows past 250 ms).
      var samples = [{ t: performance.now(), y: window.scrollY }], vel = 0;
      function fast() { return vel > 2 * window.innerHeight; }
      function atEnd() { return window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 8; }

      var visible = [];
      var pending = inkEls.filter(function (el) { return el.hasAttribute('data-hero'); });
      // Hero on a repeat visit: settled, with no ink, at its first sighting.
      var heroSettles = !firstVisit;
      function has(list, el) { return list.indexOf(el) !== -1; }
      function drop(list, el) { var k = list.indexOf(el); if (k !== -1) list.splice(k, 1); }

      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          var el = e.target;
          if (e.isIntersecting) {
            if (!has(visible, el)) visible.push(el);
            if (has(pending, el)) {
              if (heroSettles) { drop(pending, el); settle(el); }
              return;
            }
            if (fast()) settle(el); else ink(el);
          } else {
            drop(visible, el);
            drop(pending, el);
            // At the foot of the page what is on screen stays inked even
            // outside the band: there is no more scroll to bring it in.
            if (shown(el) && !(atEnd() && el.getBoundingClientRect().top < window.innerHeight)) smear(el);
          }
        });
      }, { rootMargin: '-10% 0px -25% 0px', threshold: 0 });
      inkEls.forEach(function (el) { io.observe(el); });

      // The hero: a 250 ms beat after load on the first visit of a session,
      // then the name and the tagline ink together. Later visits start inked.
      if (firstVisit) {
        setTimeout(function () {
          pending.slice().forEach(function (el) {
            drop(pending, el);
            if (has(visible, el)) ink(el);
          });
        }, 250);
      }

      // Visuals: the sink-in entrance runs once, when the frame comes up.
      var visEls = Array.prototype.slice.call(document.querySelectorAll('[data-vis]'));
      var vio = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          e.target.classList.add('in');
          vio.unobserve(e.target);
        });
      }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
      visEls.forEach(function (el) { vio.observe(el); });

      function onScroll() {
        var y = window.scrollY, t = performance.now();
        while (samples.length > 1 && t - samples[1].t >= 150) samples.shift();
        var base = samples[0];
        vel = Math.abs(y - base.y) / Math.min(250, Math.max(150, t - base.t)) * 1000;
        samples.push({ t: t, y: y });
        if (fast()) {
          // A flick: everything on screen settles at once, band or not, so
          // nothing sits blank in the bottom quarter when the flick stops.
          inkEls.forEach(function (el) {
            if (has(pending, el)) return;
            var r = el.getBoundingClientRect();
            if (r.top < window.innerHeight && r.bottom > 0) settle(el);
          });
        }
        // At the foot of the page nothing may stay un-inked for want of
        // band: whatever is on screen inks.
        if (atEnd()) {
          inkEls.forEach(function (el) {
            if (shown(el)) return;
            if (el.getBoundingClientRect().top < window.innerHeight) ink(el);
          });
        }
        main.classList.toggle('past-first', y > window.innerHeight * 0.6);
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
    })();
  </script>

  <script is:inline>
    // The fixed bar's height, so every anchor jump clears it (scroll-margin-top).
    (function () {
      var main = document.querySelector('.v16'), bar = document.querySelector('.chrome');
      if (!main || !bar) return;
      function measure() { main.style.setProperty('--chrome-h', bar.offsetHeight + 'px'); }
      measure();
      window.addEventListener('resize', measure);
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
    })();
  </script>

  <script is:inline>
    // The local player. Nothing here loads a file until a play gesture:
    // the audio element starts with no src, preload none, and the only
    // place a src is set is start(), called from a click. Changing track
    // while stopped only changes the selection. The transport (play,
    // previous, next, state) is in the top bar; the track list, status and
    // seek bar are in the Off the clock box; one audio element for both.
    (function () {
      var box = document.getElementById('player');
      var bar = document.getElementById('bar');
      if (!box || !bar) return;
      var audio = document.getElementById('player-audio');
      var base = box.getAttribute('data-base');
      var status = document.getElementById('player-status');
      var bstatus = document.getElementById('bar-status');
      var play = document.getElementById('bar-play');
      var prev = document.getElementById('bar-prev');
      var next = document.getElementById('bar-next');
      var range = document.getElementById('player-range');
      var cur = document.getElementById('player-cur');
      var dur = document.getElementById('player-dur');
      var tracks = Array.prototype.slice.call(box.querySelectorAll('.track'));
      var list = document.getElementById('player-tracks');
      // The default: what the bar's Play starts when nothing was picked
      // (On2nite). Nothing is loaded for it until that press.
      var DEF = Math.min(tracks.length - 1, Math.max(0, parseInt(list && list.getAttribute('data-default') || '0', 10) || 0));
      var sel = -1, loaded = -1, seeking = false, want = false;

      function fmt(s) { if (!isFinite(s) || s < 0) return '--:--'; s = Math.floor(s); return Math.floor(s / 60) + ':' + ('0' + (s % 60)).slice(-2); }
      function name(i) { return tracks[i].querySelector('.tile-a').textContent + ' - ' + tracks[i].querySelector('.tile-t').textContent; }
      function state(kind, text) {
        box.setAttribute('data-state', kind); bar.setAttribute('data-state', kind);
        status.textContent = text; bstatus.textContent = text;
      }
      function playing(on) {
        play.textContent = on ? 'Pause' : 'Play';
        play.setAttribute('aria-pressed', on ? 'true' : 'false');
      }
      function resetTime() {
        range.disabled = true; range.value = 0; range.setAttribute('aria-valuetext', 'No track loaded');
        cur.textContent = '0:00'; dur.textContent = '--:--';
      }
      function select(i) {
        sel = i;
        tracks.forEach(function (b, k) { b.setAttribute('aria-pressed', k === i ? 'true' : 'false'); });
        prev.disabled = i <= 0;
        next.disabled = i >= tracks.length - 1;
      }
      function unload() {
        if (loaded === -1) return;
        loaded = -1;
        audio.removeAttribute('src');
        resetTime();
      }
      // Only from a gesture (play, a tile, or next/previous while playing).
      // A tile click on the song already playing restarts it from the top
      // (fromTop); play and next/previous resume where it was.
      function start(i, fromTop) {
        select(i);
        if (loaded !== i) {
          unload();
          loaded = i;
          audio.src = base + tracks[i].getAttribute('data-track') + '.mp3';
        } else if (fromTop) {
          try { audio.currentTime = 0; } catch (e) {}
        }
        want = true;
        state('loading', 'Loading: ' + name(i));
        var p = audio.play();
        if (p && p.catch) p.catch(function (err) {
          if (err && err.name === 'AbortError') return;
          if (err && err.name === 'NotAllowedError') { state('error', 'The browser blocked playback. Press play again.'); playing(false); return; }
          fail();
        });
      }
      function fail() {
        var i = loaded !== -1 ? loaded : sel;
        want = false;
        unload();
        playing(false);
        state('error', 'Could not load ' + (i !== -1 ? name(i) : 'the track') + '. Try again, or choose another track.');
      }
      function isPlaying() { return want; }

      audio.addEventListener('loadedmetadata', function () {
        range.disabled = false;
        dur.textContent = fmt(audio.duration);
      });
      audio.addEventListener('durationchange', function () { dur.textContent = fmt(audio.duration); });
      audio.addEventListener('timeupdate', function () {
        if (seeking || !isFinite(audio.duration) || audio.duration <= 0) return;
        range.value = Math.round(audio.currentTime / audio.duration * 1000);
        cur.textContent = fmt(audio.currentTime);
        range.setAttribute('aria-valuetext', fmt(audio.currentTime) + ' of ' + fmt(audio.duration));
      });
      audio.addEventListener('playing', function () { state('playing', 'Playing: ' + name(loaded)); playing(true); });
      audio.addEventListener('waiting', function () { if (loaded !== -1) state('loading', 'Buffering: ' + name(loaded)); });
      audio.addEventListener('pause', function () {
        if (audio.ended || loaded === -1 || want) return;
        state('paused', 'Paused: ' + name(loaded));
        playing(false);
      });
      // The end of a track is not a gesture: nothing loads on its own. The
      // next track is selected and waits for play.
      audio.addEventListener('ended', function () {
        want = false;
        playing(false);
        var done = loaded;
        if (done < tracks.length - 1) {
          unload();
          select(done + 1);
          state('ended', 'Finished: ' + name(done) + '. Next: ' + name(done + 1) + '. Press play.');
          return;
        }
        state('ended', 'Finished: ' + name(done) + '. End of the list.');
      });
      audio.addEventListener('error', fail);

      play.addEventListener('click', function () {
        if (isPlaying()) { want = false; audio.pause(); return; }
        start(sel === -1 ? DEF : sel);
      });
      function step(d) {
        var i = Math.min(tracks.length - 1, Math.max(0, (sel === -1 ? DEF : sel) + d));
        if (isPlaying()) { start(i); return; }
        if (i !== loaded) unload();
        select(i);
        playing(false);
        state(loaded === i ? 'paused' : 'selected', (loaded === i ? 'Paused: ' : 'Selected: ') + name(i) + (loaded === i ? '' : '. Press play.'));
      }
      prev.addEventListener('click', function () { step(-1); });
      next.addEventListener('click', function () { step(1); });
      // A tile: load and play that song, idle or paused or mid-song; the
      // same one audio element, so nothing can play twice over.
      tracks.forEach(function (b, i) { b.addEventListener('click', function () { start(i, loaded === i && isPlaying()); }); });

      range.addEventListener('input', function () {
        if (!isFinite(audio.duration)) return;
        seeking = true;
        cur.textContent = fmt(range.value / 1000 * audio.duration);
      });
      range.addEventListener('change', function () {
        seeking = false;
        if (!isFinite(audio.duration)) return;
        audio.currentTime = range.value / 1000 * audio.duration;
      });

      // Ready: the buttons work, the seek bar waits for a loaded track.
      // Previous and next step from the default when nothing is picked.
      play.disabled = false;
      prev.disabled = DEF <= 0;
      next.disabled = DEF >= tracks.length - 1;
      tracks.forEach(function (b) { b.disabled = false; });
    })();
  </script>
