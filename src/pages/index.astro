    .proj-l { display: flex; gap: 22px; justify-content: flex-start; }

    /* All work: centered groups, rows cut by rules, text only. Under the
       heading, one row of the categories, each an anchor to its group,
       with a rule beneath. Every inventory row belongs to its category;
       the five upper feature projects are included under tooling. */
    .more { padding-top: 10vh; padding-bottom: 4vh; }
    .more .label { margin-bottom: 30px; }
    .cats {
