    .tile:hover:not(:disabled), .tile:focus-visible { transform: translate(-3px, -3px); box-shadow: 6px 6px 0 var(--ink); }
    .tile:disabled { cursor: not-allowed; color: var(--mute); border-color: var(--mute); }
    .tile[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
    .tile[aria-pressed="true"] .tile-n, .tile[aria-pressed="true"] .tile-t { color: var(--paper); opacity: .72; }
    .tile[aria-pressed="true"] .tile-go { color: var(--yellow); border-color: var(--yellow); }
    .tile-n { font: 600 12px/1 var(--mono); color: var(--mute); }
